# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ─── Database ───────────────────────────────────────────────────────────────
# Local development: leave DB_MODE=local and start Mongo however you like
#   docker compose up mongo     (recommended)
#   or a local mongod
#   or paste a MongoDB Atlas SRV string into MONGODB_URI below
#
# Production (Render): set DB_MODE=atlas and paste the Atlas SRV string.
#
# ⚠  BEFORE THIS WORKS: the Atlas cluster must (a) exist, (b) be resumed if it
#    was paused, and (c) have this machine's IP in its access list.
#    Get your public IP from https://api.ipify.org
MONGODB_URI=mongodb://127.0.0.1:27017/skillmap
DB_MODE=local

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string_32_plus
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# ─── Admin seed account ─────────────────────────────────────────────────────
ADMIN_EMAIL=admin@skillmap.ai
ADMIN_PASSWORD=ChangeMe_Admin_2026

# ─── AI / System modes ──────────────────────────────────────────────────────
# AI_MODE=demo   → deterministic, offline, no API key, clearly labelled  (default)
# AI_MODE=local  → Transformers.js embeddings, free, offline-ish, no API key
# AI_MODE=openai → real LLM calls, needs OPENAI_API_KEY
AI_MODE=demo

# OpenAI-compatible endpoint. Leave blank to use the official OpenAI API.
# Any OpenAI-compatible provider works (OpenRouter, Groq, local Ollama, ...).
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Model used for structured extraction (CV parsing, job-description analysis)
OPENAI_MODEL_EXTRACTION=
# Smaller/cheaper model used for wording-only tasks (assistant phrasing)
OPENAI_MODEL_CHAT=
# Hard spend ceiling per process lifetime, in USD. 0 disables the cap.
AI_BUDGET_USD=0

# ─── Uploads ────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
ALLOWED_UPLOAD_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ─── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=5
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_ASSISTANT=20
RATE_LIMIT_GLOBAL=300

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ─── Frontend (Vite, build-time) ────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api
